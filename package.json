{
  "name": "forz-cli",
  "version": "0.4.0",
  "description": "A zero-dependency TypeScript CLI for app.forz.io",
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts",
  "author": "Hugo <info@nygts.com>",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "yarn clean && tsc",
    "clean": "rm -rf dist/",
    "test": "jest tests/",
    "lint": "eslint --max-warnings 0 src/ tests/",
    "prettier": "prettier src/** tests/** README.md",
    "prepublishOnly": "yarn build && yarn test"
  },
  "bin": {
    "forz": "./bin/index.js"
  },
  "files": [
    "dist/**/*",
    "bin/index.js",
    "skill/forz-cli/SKILL.md",
    "skill/forz-cli/AGENTS.md",
    "skill/forz-cli.skill"
  ],
  "keywords": [
    "forz",
    "cli",
    "field-service",
    "api"
  ],
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.1",
    "@types/jest": "^26.0.21",
    "@types/node": "^14.14.35",
    "@typescript-eslint/eslint-plugin": "^4.18.0",
    "@typescript-eslint/parser": "^4.18.0",
    "eslint": "^7.22.0",
    "eslint-plugin-import": "^2.23.2",
    "jest": "^26.6.3",
    "prettier": "^2.3.0",
    "ts-jest": "^26.5.4",
    "typescript": "^4.2.3"
  },
  "dependencies": {}
}
